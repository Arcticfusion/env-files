#!/bin/sh
name_="rc"
if ! [ -n "${_RC_INIT}" ]; then
  export _RC_INIT="True"
else
  >&2 echo "Already Initialising ${name_}"
  exit
fi
>&2 echo "Initialising ${name_}"
unset name_
# RC START
# This is for all interactive shells

# Initialise Environment Tools
test -s "${HOME}/.set_env_repo" && source "${HOME}/.set_env_repo"
test -h "${HOME}/.rc" && test -z "${ENV_REPO}" &&
  export ENV_REPO=$(dirname $(readlink -f "$0" 2>/dev/null ))
test -d "${ENV_REPO}" ||
  >&2 echo -e "\e[33mWARNING: Failed to initialise ENV_REPO"
source "${ENV_REPO}/env.sh"

_USER_NAME=$( whoami | tr '[:upper:]' '[:lower:]' |  tr ' ' '-' )
test -n "${HOSTNAME}" && _HOST_NAME="${HOSTNAME}" || _HOST_NAME="${HOST}"

case "$_HOST_NAME" in
  *MacBook-*)
    _HOST_NAME="$(echo "${_HOST_NAME}" | sed -E 's/MacBook-(\w*)-(\d*)-?/MB-\1-\2/')"
  ;;
  DESKTOP-)
    _HOST_NAME="$(echo "${_HOST_NAME}" | sed -E 's/DESKTOP-*/WIN-')"
  ;;
  *)
    test "${ENV_DEBUG}" &&
      >&2 echo "No Hostname changes for ${_HOST_NAME}"
  ;;
esac
_HOST_NAME="$(echo "${_HOST_NAME}" | sed -E 's/\.local$//')"

case "$_USER_NAME" in
  unknown*)
    _USER_NAME="unknown"
  ;;
  root)
    _USER_NAME="root"
  ;;
  *.*)
    _USER_NAME="$(
      echo "$_USER_NAME" |
      sed -E 's/^\W*(\w+)/\1/'
    )"
  ;;
  *)
    # First word -> first 7 characters
    _USER_NAME="$(
      echo "$_USER_NAME" |
      sed -E -e 's/^\W*(\w+)(\W.*)?//' \
      -e 's/(.{7}).*/\1/'
    )"
  ;;
esac

test -z "${USER}" && export USER="${USERNAME}"
test -z "${USER}" && export USER="$(whoami 2>/dev/null)"

export _HOST_NAME
export _USER_NAME

OS_NAME=$(uname | lower)
if [[ "$OS_NAME" == "darwin"* ]] ; then
  quiet which sw_vers &&
    OS_NAME=$(sw_vers -productName | lower)
fi
export OS_NAME

case "$OS_NAME" in
  macos*)
    load_env_file "macos.sh"
  ;;
  linux*)
    load_env_file "linux.sh"
  ;;
  mingw64*)
    load_env_file "windows.sh"
  ;;
  *)
    echo "OS:$OS_NAME has no env preferences" 1>&2
  ;;
esac

# checkt conda && load_env_file conda.sh
load_env_file data/vars.rc
load_env_file aliases
load_env_file tools.sh

checkt q && {
  pykx_path="$HOME/.kx/venv/lib/python3.14/site-packages/pykx"
  test -d "$pykx_path" &&
    export QPATH="$QPATH:$pykx_path"
  unset pykx_path
}

# RC END
test -n "${ENV_DEBUG}" &&
  >&2 echo -e "\trc is Initialised"
unset _RC_INIT
